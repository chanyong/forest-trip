{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd web && npm ci",
  "buildCommand": "cd web && npm run build",
  "outputDirectory": "web/dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(self), camera=(), microphone=()"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, s-maxage=300, stale-while-revalidate=900"
        }
      ]
    },
    {
      "source": "/alerts-feed.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, s-maxage=300, stale-while-revalidate=900"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(og-image.png|apple-touch-icon.png|icon-192.png|icon-512.png|favicon.svg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.supgaja.com"
        }
      ],
      "destination": "https://supgaja.com/$1",
      "statusCode": 301
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "forest-trip-seven.vercel.app"
        }
      ],
      "destination": "https://supgaja.com/$1",
      "statusCode": 301
    },
    {
      "source": "/faq",
      "destination": "/faq.html",
      "statusCode": 301
    },
    {
      "source": "/faq/",
      "destination": "/faq.html",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/forest/:id",
      "destination": "/forest/:id/index.html"
    },
    {
      "source": "/vacancy/:r",
      "destination": "/vacancy/:r/index.html"
    },
    {
      "source": "/vacancy/:r/:p",
      "destination": "/vacancy/:r/:p/index.html"
    }
  ]
}
